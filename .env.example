# Rootfetch Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-random-secret
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./rootfetch.db

# API Keys (comma-separated key:credits pairs to seed on first run)
DEFAULT_API_KEYS=test-key:1000,demo-key:500

# Search Engine API Keys (optional — free scrapers work without these)
SERPAPI_API_KEY=
BING_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# LLM
OPENAI_API_KEY=

# Proxy
PROXY_URL=

# Rate Limiting
KEYLESS_RATE_LIMIT=20/minute
KEYED_RATE_LIMIT=100/minute
PREMIUM_RATE_LIMIT=1000/minute

# Crawler
CRAWL_USER_AGENT=Rootfetch/1.0 (Research Bot; +https://github.com/user/rootfetch)
CRAWL_DELAY=1.0
CRAWL_MAX_PAGES=1000
